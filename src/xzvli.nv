// xzvli.nv — the variable-length integer every size field in an `.xz`
// file is, and the four-byte padding rule that goes with it.
//
// WHAT A VLI IS.  Seven bits per byte, low bits first, with the top bit
// set on every byte but the last: the same shape as a protobuf varint.
// It is how a block header says how large its block is, how the index
// says how large each block was, and how the number of index records is
// written.
//
// AND THE FORMAT REQUIRES THE SHORTEST ENCODING.  `0x80 0x00` and
// `0x00` both decode to zero under a naive reader, and the xz format
// specification refuses the first.  That is not pedantry: a block's
// size appears twice in a file, once in its header and once in the
// index, and if one number has several spellings then a file can be
// built whose two copies decode the same and hash differently.  So
// `decode` refuses a non-canonical encoding, and `encode_bytes` answers
// the one length the format permits.
//
// THE CEILING IS 2^63 - 1, IN NINE BYTES.  Nine bytes of seven bits is
// sixty-three, which is the format's stated maximum and also what fits
// in a signed 64-bit integer — so a decoder never has to reason about a
// size it cannot represent.
//
// PADDING IS ZEROES TO A MULTIPLE OF FOUR, and it appears in three
// places: after a block's compressed data, after the index, and between
// streams.  It is always checked, never skipped: non-zero padding is a
// corrupt file and not a decoder's business to tolerate.

use xzerror

// The most bytes a variable-length integer may occupy: 9.
pub const XZ_VLI_BYTES_MOST = 9

// The largest value a variable-length integer may hold: 2^63 - 1.
pub const XZ_VLI_MAX = 9223372036854775807

// The alignment every padding field pads to: 4 bytes.
pub const XZ_PADDING_ALIGN = 4

// One decoded variable-length integer: the value and how many bytes it
// took.
//
// A `@value` struct, so a reader walking an index of ten thousand
// records carries it in registers and allocates nothing.
//
// `ok` is false when the integer did not terminate within nine bytes,
// when it was not in shortest form, or when there were not enough bytes
// to finish it.  A `Result` would be the shape everywhere else in this
// package, and it is not the shape here: a `@value` struct cannot be a
// `Result` payload, and an index reader that allocated per record would
// allocate ten thousand times to read a table of contents.
pub @value
struct XzVli
    // The value, or 0 when `ok` is false.
    value: Int
    // How many bytes it occupied, `1` ..= `9`, or 0 when `ok` is false.
    bytes: Int
    // Whether a canonical integer was read at all.
    ok: Bool

// Read a variable-length integer from `src` at `off`.
//
// Refuses a tenth byte, a value above `XZ_VLI_MAX`, and an encoding
// longer than the value needs.  Runs out of bytes rather than reading
// past the end, which `ok` reports the same way — the caller
// distinguishes the two with `bytes_left`.
//
// ```novo
// use std.bytes
// use xzvli
//
// fn main() [io]
//     let v = xzvli.decode(bytes.from_str("\u{00}"), 0)
//     println("${v.value} ${v.bytes} ${v.ok}")
// ```
pub fn decode(src: Bytes, off: Int) -> XzVli []
    var value = 0
    var shift = 0
    var i = 0
    while i < XZ_VLI_BYTES_MOST
        match bytes.byte_at(src, off + i)
            None    =>
                return XzVli { value: 0, bytes: 0, ok: false }
            Some(b) =>
                value = value | ((b & 0x7F) << shift)
                if (b & 0x80) == 0
                    // The last byte.  A zero here carries no bits that
                    // the byte before it did not already carry, so a
                    // multi-byte encoding that ends in zero is one of
                    // the spellings the format refuses.
                    if i > 0 and b == 0
                        return XzVli { value: 0, bytes: 0, ok: false }
                    return XzVli { value: value, bytes: i + 1, ok: true }
        shift = shift + 7
        i = i + 1
    XzVli { value: 0, bytes: 0, ok: false }

// The fault a `decode` that answered `ok == false` should be reported
// as, or `None`.
//
// `XzBadVli` at the offset, which `xzerror.is_corrupt` calls damage.
// The bridge between the flag `decode` answers and the `Result` every
// other entry point in this package speaks.
//
// ```novo
// use std.bytes
// use xzvli
//
// fn main() [io]
//     match xzvli.decode_fault(xzvli.decode(bytes.zeros(0), 0), 0)
//         Some(_) => println("not a canonical integer")
//         None    => println("read cleanly")
// ```
pub fn decode_fault(v: XzVli, off: Int) -> ?XzFault []
    if v.ok
        None
    else
        Some(xzerror.fault(XzBadVli(off), xzerror.here(-1, off, xzerror.XZ_LAYER_STREAM)))

// How many bytes the shortest encoding of `n` occupies, `1` ..= `9`.
//
// `XzBadParameter` for a negative `n`.  The function an encoder sizes
// a header with, and the function `decode` checks a file's encoding
// against.
//
// ```novo
// use xzvli
//
// fn main() [io]
//     match xzvli.encoded_bytes(127)
//         Ok(n)  => println("${n}")
//         Err(_) => println("not a value")
// ```
pub fn encoded_bytes(n: Int) -> Result<Int, XzFault> []
    if n < 0
        return Err(xzerror.fault(XzBadParameter("encoded_bytes: a negative value"),
                                 xzerror.here(-1, -1, xzerror.XZ_LAYER_STREAM)))
    var left = n
    var count = 1
    while left >= 128 and count < XZ_VLI_BYTES_MOST
        left = left >>> 7
        count = count + 1
    Ok(count)

// The bytes `n` encodes to, in the one form the format permits.
//
// ```novo
// use std.bytes
// use xzvli
//
// fn main() [io]
//     match xzvli.encode(300)
//         Ok(b)  => println("${bytes.len(b)}")
//         Err(f) => println(f.message())
// ```
pub fn encode(n: Int) -> Result<Bytes, XzFault> []
    match encoded_bytes(n)
        Err(f)    => Err(f)
        Ok(count) =>
            var dst = bytes.zeros(count)
            match encode_into(n, var dst, 0)
                // cov: skip — `encoded_bytes` sized the value before this writes it
                Err(f) => Err(f)
                Ok(_)  => Ok(dst)

// Write `n` into a caller's buffer at `at`, and answer how many bytes
// were written.
//
// The allocation-free form, for a header being assembled into a buffer
// the caller already sized.  `XzBufferTooSmall` when `dst` has less
// room than `encoded_bytes(n)`.
//
// ```novo
// use std.bytes
// use xzvli
//
// fn main() [io]
//     match xzvli.encode_into(300, bytes.zeros(9), 0)
//         Ok(n)  => println("${n}")
//         Err(f) => println(f.message())
// ```
pub fn encode_into(n: Int, var dst: Bytes, at: Int) -> Result<Int, XzFault> []
    match encoded_bytes(n)
        Err(f)    => Err(f)
        Ok(count) =>
            if bytes.len(dst) < at + count
                return Err(xzerror.fault(XzBufferTooSmall(at + count, bytes.len(dst)),
                                         xzerror.here(-1, at, xzerror.XZ_LAYER_STREAM)))
            var left = n
            for i in 0..count
                var b = left & 0x7F
                left = left >>> 7
                if i < count - 1
                    b = b | 0x80
                dst = bytes.set_u8(dst, at + i, b)
            Ok(count)

// How many padding bytes follow `n` bytes of content: `0` ..= `3`.
//
// The rule in all three places padding appears — after a block's
// compressed data, after the index, and between streams — so a caller
// never writes the modulo itself.
//
// ```novo
// use xzvli
//
// fn main() [io]
//     println("${xzvli.padding_after(5)}")
// ```
pub fn padding_after(n: Int) -> Int []
    (XZ_PADDING_ALIGN - n % XZ_PADDING_ALIGN) % XZ_PADDING_ALIGN

// Whether `n` bytes of `src` from `off` are all zero.
//
// Padding is checked, not skipped: non-zero padding is a corrupt file.
// A decoder that skipped it would accept a file with data hidden in
// it, which is the shape covert-channel bugs take in every container
// format that has padding.
//
// ```novo
// use std.bytes
// use xzvli
//
// fn main() [io]
//     println("${xzvli.padding_is_clean(bytes.zeros(3), 0, 3)}")
// ```
pub fn padding_is_clean(src: Bytes, off: Int, n: Int) -> Bool []
    for i in 0..n
        // A byte past the end of the buffer reads as zero, the house
        // rule for a range the caller has already bounded: the caller
        // that could not spare the bytes is the caller that checks the
        // length first.
        if (bytes.byte_at(src, off + i) ?? 0) != 0
            return false
    true

// `n` rounded up to the next multiple of four.
//
// ```novo
// use xzvli
//
// fn main() [io]
//     println("${xzvli.round_up(5)}")
// ```
pub fn round_up(n: Int) -> Int []
    n + padding_after(n)
