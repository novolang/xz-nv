// xzstream.nv — the twelve bytes at the front and the twelve at the
// back, and why the format writes the flags twice.
//
// AN `.xz` FILE IS A SEQUENCE OF STREAMS, with four-byte-aligned zero
// padding allowed between them.  Concatenation is the format's own
// multi-file convention, and `xz --block-list` and `pixz` both produce
// files that use it, so a decoder that stopped after the first footer
// would silently truncate them.
//
// A STREAM IS HEADER, BLOCKS, INDEX, FOOTER, and the footer is what
// makes an `.xz` seekable: it carries the size of the index, so a
// reader that can seek jumps to twelve bytes before the end, reads
// backwards to the index, and has a table of contents without touching
// a single compressed byte.
//
// THE FLAGS ARE WRITTEN TWICE ON PURPOSE.  The two stream-flag bytes
// appear in the header and again in the footer, and the format requires
// them to be equal.  That is not redundancy for its own sake: it is
// what catches a file that was truncated and had another file's tail
// appended, which is the failure mode of a naive resume-a-download.
//
// AND THE HEADER CHECKSUMS ITSELF.  A CRC-32 over the two flag bytes
// sits in both places, so a decoder can tell "this is not an xz file"
// from "this is an xz file whose first twelve bytes are damaged" — a
// distinction a caller sniffing an unknown archive actually acts on.

use xzerror
use crc

// The six magic bytes an `.xz` stream starts with:
// `FD 37 7A 58 5A 00`.
//
// The first byte has its high bit set and the next four spell `7zXZ`,
// so the file is recognisable as binary to a tool that samples the
// first byte and recognisable as xz to a person with a hex dump.
pub const XZ_HEADER_MAGIC_BYTES = 6

// The two magic bytes an `.xz` stream ends with: `59 5A`, `YZ`.
pub const XZ_FOOTER_MAGIC_BYTES = 2

// The whole stream header's size: 12 bytes.
//
// Six of magic, two of flags, four of CRC-32 over the flags.
pub const XZ_HEADER_BYTES = 12

// The whole stream footer's size: 12 bytes.
//
// Four of CRC-32, four of backward size, two of flags, two of magic.
// The same size as the header, which is what lets a seeking reader
// take the last twelve bytes without knowing anything else.
pub const XZ_FOOTER_BYTES = 12

// Whether the six bytes of `src` from `off` are `FD 37 7A 58 5A 00`.
//
// The one place the magic is spelled, so the header and the caller
// sniffing a file cannot disagree about it.
fn magic_at(src: Bytes, off: Int) -> Bool
    (bytes.byte_at(src, off) ?? -1) == 0xFD
        and (bytes.byte_at(src, off + 1) ?? -1) == '7'
        and (bytes.byte_at(src, off + 2) ?? -1) == 'z'
        and (bytes.byte_at(src, off + 3) ?? -1) == 'X'
        and (bytes.byte_at(src, off + 4) ?? -1) == 'Z'
        and (bytes.byte_at(src, off + 5) ?? -1) == '\0'

// The finished CRC-32 of `n` bytes of `src` from `off`.
//
// The algorithm value is bound before it is used, because a field read
// off a call in one expression is the shape that leaks — and because
// `crc.crc32()` builds a 256-entry table that should be built once per
// check rather than once per call.
fn crc32_of(src: Bytes, off: Int, n: Int) -> Int
    let algo = crc.crc32()
    algo.finish(algo.update_range(algo.start(), src, off, n))

// A stream's flags: the check type the whole stream uses.
//
// Two bytes in the file.  The first is reserved and must be zero; the
// low four bits of the second are the check type and the top four are
// reserved.
//
// ```novo
// use xzstream
// use xzcheck
//
// fn main() [io]
//     match xzstream.flags(xzcheck.XZ_CHECK_CRC64)
//         Ok(f)  => println("${f.check}")
//         Err(_) => println("not a check type")
// ```
pub struct XzStreamFlags
    // The check type every block in this stream carries, one of
    // `xzcheck.XZ_CHECK_*` or a reserved value.
    check: Int

// Stream flags for a check type.
//
// `XzBadParameter` for a type outside `0` ..= `15`.  A RESERVED type
// is accepted here — the flags are what a file says, and refusing one
// at construction would make an unsupported-check file unreadable
// rather than merely unverifiable.
//
// ```novo
// use xzstream
// use xzcheck
//
// fn main() [io]
//     match xzstream.flags(xzcheck.XZ_CHECK_NONE)
//         Ok(f)  => println("${f.check}")
//         Err(e) => println(e.message())
// ```
pub fn flags(check: Int) -> Result<XzStreamFlags, XzFault> []
    if check < 0 or check > 0x0F
        return Err(xzerror.fault(
            XzBadParameter("flags: a check type outside 0 to 15"),
            xzerror.here(-1, -1, xzerror.XZ_LAYER_STREAM)))
    Ok(XzStreamFlags { check: check })

// An `.xz` stream header, read from the first twelve bytes.
//
// ```novo
// use std.bytes
// use xzstream
//
// fn main() [io]
//     match xzstream.read_header(bytes.zeros(12))
//         Ok(h)  => println("${h.flags.check}")
//         Err(e) => println(e.message())
// ```
pub struct XzStreamHeader
    // The flags this stream declares.
    flags: XzStreamFlags

// Read a stream header from the first twelve bytes of `src` at `off`.
//
// `XzBadMagic` when the six magic bytes are wrong — the file is not
// `.xz` at all, and `xzerror.is_corrupt` answers true for it.  `XzHeaderCrcMismatch` when they are right and the
// CRC over the flags is not: the file IS `.xz` and its first twelve
// bytes are damaged, which is a different thing to tell a user.
// `XzReservedBitSet` when a reserved bit is set.
//
// ```novo
// use std.bytes
// use xzstream
//
// fn main() [io]
//     match xzstream.read_header(bytes.zeros(12))
//         Ok(h)  => println("${h.flags.check}")
//         Err(e) => println(e.message())
// ```
pub fn read_header(src: Bytes) -> Result<XzStreamHeader, XzFault> []
    let at = xzerror.here(-1, 0, xzerror.XZ_LAYER_STREAM)
    if bytes.len(src) < XZ_HEADER_BYTES
        return Err(xzerror.fault(XzTruncated(XZ_HEADER_BYTES - bytes.len(src)), at))
    if not magic_at(src, 0)
        return Err(xzerror.fault(XzBadMagic, at))
    let first = bytes.byte_at(src, 6) ?? -1
    let second = bytes.byte_at(src, 7) ?? -1
    if first != 0
        return Err(xzerror.fault(XzReservedBitSet(6), at))
    if (second & 0xF0) != 0
        return Err(xzerror.fault(XzReservedBitSet(7), at))
    let declared = bytes.u32_le_at(src, 8) ?? -1
    let computed = crc32_of(src, 6, 2)
    if declared != computed
        return Err(xzerror.fault(XzHeaderCrcMismatch(declared, computed), at))
    Ok(XzStreamHeader { flags: XzStreamFlags { check: second & 0x0F } })

// The twelve bytes a stream header is, for a given set of flags.
//
// ```novo
// use std.bytes
// use xzstream
// use xzcheck
//
// fn main() [io]
//     match xzstream.flags(xzcheck.XZ_CHECK_CRC32)
//         Ok(f)  => println("${bytes.len(xzstream.header_bytes(f))}")
//         Err(_) => println("not a check type")
// ```
pub fn header_bytes(f: XzStreamFlags) -> Bytes []
    var out = bytes.zeros(XZ_HEADER_BYTES)
    bytes.set_u8(out, 0, 0xFD)
    bytes.set_u8(out, 1, 0x37)
    bytes.set_u8(out, 2, 0x7A)
    bytes.set_u8(out, 3, 0x58)
    bytes.set_u8(out, 4, 0x5A)
    bytes.set_u8(out, 5, 0x00)
    bytes.set_u8(out, 6, 0)
    bytes.set_u8(out, 7, f.check & 0x0F)
    bytes.set_u32_le(out, 8, crc32_of(out, 6, 2))
    out

// An `.xz` stream footer.
//
// ```novo
// use std.bytes
// use xzstream
//
// fn main() [io]
//     match xzstream.read_footer(bytes.zeros(12))
//         Ok(f)  => println("${f.index_bytes}")
//         Err(e) => println(e.message())
// ```
pub struct XzStreamFooter
    // The flags, which must equal the header's.
    flags: XzStreamFlags
    // How many bytes the index occupies, decoded from the footer's
    // four-byte backward-size field.
    //
    // THE FIELD THAT MAKES AN `.xz` SEEKABLE.  Stored as
    // `(size / 4) - 1` so that four bytes reach 16 GiB of index; this
    // is the decoded byte count, so a caller never does the
    // arithmetic.
    index_bytes: Int

// Read a stream footer from twelve bytes of `src` at `off`.
//
// `XzBadFooterMagic` when the last two bytes are not `YZ`, and
// `XzHeaderCrcMismatch` when the CRC over the backward size and the
// flags does not match.
//
// ```novo
// use std.bytes
// use xzstream
//
// fn main() [io]
//     match xzstream.read_footer(bytes.zeros(12))
//         Ok(f)  => println("${f.index_bytes}")
//         Err(e) => println(e.message())
// ```
pub fn read_footer(src: Bytes) -> Result<XzStreamFooter, XzFault> []
    let at = xzerror.here(-1, 0, xzerror.XZ_LAYER_STREAM)
    if bytes.len(src) < XZ_FOOTER_BYTES
        return Err(xzerror.fault(XzTruncated(XZ_FOOTER_BYTES - bytes.len(src)), at))
    if (bytes.byte_at(src, 10) ?? -1) != 'Y' or (bytes.byte_at(src, 11) ?? -1) != 'Z'
        return Err(xzerror.fault(XzBadFooterMagic, at))
    let first = bytes.byte_at(src, 8) ?? -1
    let second = bytes.byte_at(src, 9) ?? -1
    if first != 0
        return Err(xzerror.fault(XzReservedBitSet(8), at))
    if (second & 0xF0) != 0
        return Err(xzerror.fault(XzReservedBitSet(9), at))
    let declared = bytes.u32_le_at(src, 0) ?? -1
    let computed = crc32_of(src, 4, 6)
    if declared != computed
        return Err(xzerror.fault(XzHeaderCrcMismatch(declared, computed), at))
    let stored = bytes.u32_le_at(src, 4) ?? -1
    Ok(XzStreamFooter { flags: XzStreamFlags { check: second & 0x0F },
                        index_bytes: (stored + 1) * 4 })

// The twelve bytes a stream footer is.
//
// `XzBadParameter` when `index_bytes` is not a positive multiple of
// four, which is the only thing the backward-size field can encode.
//
// ```novo
// use std.bytes
// use xzstream
// use xzcheck
//
// fn main() [io]
//     match xzstream.flags(xzcheck.XZ_CHECK_CRC32)
//         Ok(f) =>
//             match xzstream.footer_bytes(f, 4)
//                 Ok(b)  => println("${bytes.len(b)}")
//                 Err(e) => println(e.message())
//         Err(_) => println("not a check type")
// ```
pub fn footer_bytes(f: XzStreamFlags, index_bytes: Int) -> Result<Bytes, XzFault> []
    if index_bytes <= 0 or index_bytes % 4 != 0
        return Err(xzerror.fault(
            XzBadParameter("footer_bytes: an index size that is not a positive multiple of four"),
            xzerror.here(-1, -1, xzerror.XZ_LAYER_STREAM)))
    var out = bytes.zeros(XZ_FOOTER_BYTES)
    bytes.set_u32_le(out, 4, index_bytes / 4 - 1)
    bytes.set_u8(out, 8, 0)
    bytes.set_u8(out, 9, f.check & 0x0F)
    bytes.set_u8(out, 10, 0x59)
    bytes.set_u8(out, 11, 0x5A)
    bytes.set_u32_le(out, 0, crc32_of(out, 4, 6))
    Ok(out)

// Whether a header's flags and a footer's agree.
//
// THE CHECK THAT CATCHES A TRUNCATED-AND-REAPPENDED FILE, which is the
// failure mode of a naive resume-a-download, and the reason the format
// writes the two bytes twice.  `XzFlagsMismatch` when they do not.
//
// ```novo
// use xzstream
// use xzcheck
//
// fn main() [io]
//     match xzstream.flags(xzcheck.XZ_CHECK_CRC32)
//         Ok(f)  => println("${xzstream.flags_agree(f, f)}")
//         Err(_) => println("not a check type")
// ```
pub fn flags_agree(header: XzStreamFlags, footer: XzStreamFlags) -> Bool []
    header.check == footer.check

// The check type a stream declares, as a number.
//
// ```novo
// use std.bytes
// use xzstream
// use xzcheck
//
// fn main() [io]
//     match xzstream.read_header(bytes.zeros(12))
//         Ok(h)  => println(xzcheck.name_of(xzstream.check_of(h)))
//         Err(e) => println(e.message())
// ```
pub fn check_of(h: XzStreamHeader) -> Int []
    h.flags.check

// How many bytes of stream padding follow a stream that ended at
// `offset`: `0` ..= `3`.
//
// Streams in a concatenated `.xz` are separated by zeroes to a
// four-byte boundary, and the next stream's magic starts on it.  A
// caller scanning for a second stream needs exactly this number.
//
// ```novo
// use xzstream
//
// fn main() [io]
//     println("${xzstream.padding_after(13)}")
// ```
pub fn padding_after(offset: Int) -> Int []
    (4 - offset % 4) % 4
