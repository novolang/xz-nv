// xzrange.nv — the binary range decoder LZMA is built on, as two
// integers and a caller's probability array.
//
// WHAT A RANGE CODER IS.  An arithmetic coder over single bits.  The
// decoder holds an interval — `range`, a 32-bit width — and a `code`
// somewhere inside it.  Each bit is decoded by splitting the interval
// in proportion to that bit's probability, seeing which half `code`
// fell in, and then ADAPTING the probability towards the bit that was
// seen.  Because the split is by probability rather than by half, a bit
// that is nearly always zero costs far less than one bit.
//
// EVERY PROBABILITY IS AN 11-BIT INTEGER AND THERE ARE THOUSANDS OF
// THEM.  LZMA's model is one array of `Int`, indexed by a context the
// symbol decoder computes: which state the machine is in, the low bits
// of the previous byte, the position modulo a power of two.  A
// dictionary-sized model for `lc = 3, lp = 0` is 12,288 probabilities
// for the literals alone.
//
// SO THE ARRAY IS THE CALLER'S, AND THIS MODULE NEVER OWNS ONE.
// `decode_bit` takes one probability VALUE and answers the updated one
// beside the bit; the caller writes it back where it came from.  A
// range coder that held the array would have to allocate it, which is
// the largest allocation in the decoder after the dictionary, and would
// make this module untestable without one.
//
// `XzRangeStep` IS A `@value` STRUCT AND ANSWERS A FLAG.  A megabyte of
// LZMA is some tens of millions of bit decodes, and a `Result` per
// decode would allocate tens of millions of times.  A `@value` struct
// cannot be a `Result` payload in v1 anyway; here the two facts point
// the same way, which is the shape bitstream-nv's `BitTake` settled on
// for the same reason.

use xzerror

// One byte of a source, or zero past its end: the callers below have
// already bounded what they read.
fn byte_of(src: Bytes, k: Int) -> Int
    bytes.byte_at(src, k) ?? 0

// The low 32 bits of an integer, which is what every field in the
// coder wraps at.
fn u32(n: Int) -> Int
    n & 0xFFFFFFFF

// The probability at index `i` of a caller's array: two bytes, little
// endian, eleven significant bits.
//
// THE GUARD IS THE SAME RULE `byte_of` FOLLOWS.  The array is the
// caller's and `probability_count` says how big it must be; a caller
// that passed a shorter one gets the value an unadapted probability
// would hold rather than an abort.  Zero would be the wrong default
// here — in this model zero means "certainly a one", not "no
// information" — and 1024 is what a fresh array holds.
fn prob_read(probs: Bytes, i: Int) -> Int
    if i < 0 or i * 2 + 1 >= bytes.len(probs)
        return XZ_PROB_INIT
    byte_of(probs, i * 2) | (byte_of(probs, i * 2 + 1) << 8)

// Write one back where it came from, if it came from inside the array.
//
// A short array is tolerated on the read side, so it must be tolerated
// on the write side too: the read answered a value the caller did not
// store, and there is nowhere to put the adapted one.
fn prob_write(var probs: Bytes, i: Int, v: Int)
    if i < 0 or i * 2 + 1 >= bytes.len(probs)
        return
    bytes.set_u8(probs, i * 2, v)
    bytes.set_u8(probs, i * 2 + 1, v >>> 8)

// The width of a probability, in bits: 11.
pub const XZ_PROB_BITS = 11

// The value a probability is initialised to: 1024, one half.
//
// Every probability in the model starts here, at the start of a stream
// and at every state reset, because before a symbol has been seen
// there is no reason to favour either bit.
pub const XZ_PROB_INIT = 1024

// The shift the adaptation uses: 5.
//
// A probability moves about a thirty-second of the way towards the bit
// that was seen.  Slower than a typical adaptive coder, which is what
// suits LZMA's very long streams.
pub const XZ_PROB_MOVE_BITS = 5

// The value below which the coder normalises: `1 << 24`.
pub const XZ_RANGE_TOP = 16777216

// How many bytes a range-coded stream starts with: 5.
//
// The first must be zero — a decoder that finds anything else has been
// handed something that is not an LZMA stream, and it is the cheapest
// check in the format.
pub const XZ_RANGE_INIT_BYTES = 5

// A range decoder between bits.
//
// A `@value` struct: two integers in the caller's stack frame, no
// header, no reference count and no allocation.  The inner loop of an
// LZMA decoder owns one.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     let r = xzrange.start(bytes.zeros(5), 0)
//     println("${r.ok}")
// ```
pub @value
struct XzRange
    // The interval's width, `0` ..= `2^32 - 1`.
    range: Int
    // Where in the interval the encoded value falls.
    code: Int
    // How many bytes of the source have been consumed.
    consumed: Int
    // False once the coder has been handed a stream whose first byte
    // was not zero, or has run out of bytes.  Once false it stays
    // false.
    ok: Bool

// Start a range decoder over the five initialisation bytes at `off`.
//
// `ok` is false when the first byte is not zero or when there are
// fewer than five bytes — `start_fault` says which.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     println("${xzrange.start(bytes.zeros(5), 0).consumed}")
// ```
pub fn start(src: Bytes, off: Int) -> XzRange []
    let bad = XzRange { range: 0, code: 0, consumed: 0, ok: false }
    if off < 0 or bytes.len(src) - off < XZ_RANGE_INIT_BYTES
        return bad
    if byte_of(src, off) != 0
        return bad
    // The four bytes after the zero one, big-endian, are the code.
    var code = 0
    var k = 1
    while k < XZ_RANGE_INIT_BYTES
        code = u32((code << 8) | byte_of(src, off + k))
        k = k + 1
    XzRange { range: 0xFFFFFFFF, code: code, consumed: XZ_RANGE_INIT_BYTES, ok: true }

// The fault a `start` that answered `ok == false` should be reported
// as, or `None`.
//
// `XzBadRangeCoder` at the offset, which `xzerror.is_corrupt` calls
// damage.  The bridge between the flag this
// module answers and the `Result` every entry point above it speaks.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     match xzrange.start_fault(xzrange.start(bytes.zeros(0), 0), 0)
//         Some(_) => println("not a range-coded stream")
//         None    => println("started cleanly")
// ```
pub fn start_fault(r: XzRange, off: Int) -> ?XzFault []
    if r.ok
        return None
    Some(xzerror.fault(XzBadRangeCoder(off),
                       xzerror.here(-1, off, xzerror.XZ_LAYER_LZMA)))

// What one bit decode produced.
//
// A `@value` struct, for the reason in the module comment: a megabyte
// of LZMA is tens of millions of these.
pub @value
struct XzRangeStep
    // The coder after the bit.
    coder: XzRange
    // The bit, 0 or 1.
    bit: Int
    // The probability, ADAPTED towards the bit that was seen.  The
    // caller writes it back into its own array at the index it read it
    // from; this module never holds one.
    prob: Int

// Read the next source byte if the interval has fallen below the top:
// the `rc_normalize` every form of decode starts with.
//
// One shift is enough, and the reason is the model's own range: after
// any bit the interval is at least `2^24 * 31 / 2048`, so one eight-bit
// shift always puts it back above `2^24`.
fn normalized(r: XzRange, src: Bytes, off: Int) -> XzRange
    if not r.ok
        return r
    if r.range >= XZ_RANGE_TOP
        return r
    if off + r.consumed >= bytes.len(src)
        return XzRange { range: r.range, code: r.code,
                         consumed: r.consumed, ok: false }
    XzRange {
        range: u32(r.range << 8),
        code: u32((r.code << 8) | byte_of(src, off + r.consumed)),
        consumed: r.consumed + 1,
        ok: true }

// One bit decode: the normalization first, then the interval split.
//
// Private because every public answer is a step: `decode_bit` is this
// one call, the two trees are it in a loop, and `decode_direct` is its
// probability-free twin below.
//
// An `ok` coder that has run out of source answers a step whose coder
// is no longer `ok`, which is how the symbol loop above hears about it.
fn bit_step(r: XzRange, prob: Int, src: Bytes, off: Int) -> XzRangeStep
    let coder = normalized(r, src, off)
    if not coder.ok
        return XzRangeStep { coder: coder, bit: 0, prob: prob }
    let bound = (coder.range >>> XZ_PROB_BITS) * prob
    if coder.code < bound
        XzRangeStep {
            coder: XzRange { range: bound, code: coder.code,
                             consumed: coder.consumed, ok: true },
            bit: 0,
            prob: adapt(prob, 0) }
    else
        XzRangeStep {
            coder: XzRange { range: coder.range - bound,
                             code: coder.code - bound,
                             consumed: coder.consumed, ok: true },
            bit: 1,
            prob: adapt(prob, 1) }

// One direct bit: the interval is split in half and no probability is
// involved.  The C's `rc_direct`, including its trick of reading the
// borrow out of the sign bit.
fn direct_step(r: XzRange, src: Bytes, off: Int) -> XzRangeStep
    let coder = normalized(r, src, off)
    if not coder.ok
        return XzRangeStep { coder: coder, bit: 0, prob: 0 }
    let half = coder.range >>> 1
    if coder.code >= half
        XzRangeStep {
            coder: XzRange { range: half, code: coder.code - half,
                             consumed: coder.consumed, ok: true },
            bit: 1,
            prob: 0 }
    else
        XzRangeStep {
            coder: XzRange { range: half, code: coder.code,
                             consumed: coder.consumed, ok: true },
            bit: 0,
            prob: 0 }

// A bit tree of `n` levels, forwards or backwards.
//
// One function because the two differ in one line: the tree walks
// `m = 2m + bit` either way, and only the symbol being assembled
// changes — high bit first for the forward tree, low bit first for the
// reverse one, which is how LZMA reads a distance's aligned low bits.
fn tree_step(r: XzRange, n: Int, var probs: Bytes, at: Int, src: Bytes, off: Int,
             forward: Bool) -> XzRangeStep
    var coder = r
    var m = 1
    var symbol = 0
    var k = 0
    while k < n and coder.ok
        let step = bit_step(coder, prob_read(probs, at + m), src, off)
        coder = step.coder
        prob_write(var probs, at + m, step.prob)
        m = m * 2 + step.bit
        if forward
            symbol = symbol * 2 + step.bit
        else
            symbol = symbol | (step.bit << k)
        k = k + 1
    XzRangeStep { coder: coder, bit: symbol, prob: 0 }

// Decode one bit against a probability, and answer the adapted
// probability beside it.
//
// THE FUNCTION THE WHOLE FORMAT IS BUILT ON.  Every literal, every
// match length, every distance bit and every rep flag in an LZMA
// stream is a sequence of these.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     let s = xzrange.decode_bit(xzrange.start(bytes.zeros(5), 0),
//                                xzrange.XZ_PROB_INIT, bytes.zeros(16), 0)
//     println("${s.bit}")
// ```
pub fn decode_bit(r: XzRange, prob: Int, src: Bytes, off: Int) -> XzRangeStep []
    bit_step(r, prob, src, off)

// Bring the coder above the normalisation threshold, reading the next
// source byte if it is below it, and answer the coder.
//
// THE CALL THAT ENDS AN LZMA2 CHUNK.  A chunk knows how many bytes it
// produces, so the decoder stops there — but the coder may still be
// holding an interval narrow enough to need one more byte, and the
// reference decoder reads it anyway ("in rare cases there is a useless
// byte that needs to be read anyway") before asking whether the coder
// came to rest.  A decoder that skips this call consumes one source
// byte fewer than the chunk says it holds, and rejects a file every
// other decoder accepts.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     println("${xzrange.normalize(xzrange.start(bytes.zeros(5), 0),
//                                  bytes.zeros(16), 0).consumed}")
// ```
pub fn normalize(r: XzRange, src: Bytes, off: Int) -> XzRange []
    normalized(r, src, off)

// Decode `n` bits with no probability model at all, at exactly one bit
// each.
//
// LZMA writes the low bits of a large distance this way, because a
// distance's low bits are very nearly uniform and modelling them would
// cost more table than it saved.  `n` is `1` ..= `32`.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     let s = xzrange.decode_direct(xzrange.start(bytes.zeros(5), 0), 4,
//                                   bytes.zeros(16), 0)
//     println("${s.bit}")
// ```
pub fn decode_direct(r: XzRange, n: Int, src: Bytes, off: Int) -> XzRangeStep []
    var coder = r
    var symbol = 0
    var k = 0
    while k < n and coder.ok
        let step = direct_step(coder, src, off)
        coder = step.coder
        symbol = symbol * 2 + step.bit
        k = k + 1
    XzRangeStep { coder: coder, bit: symbol, prob: 0 }

// Decode a bit tree of `n` levels: `n` bit decodes against `2^n`
// probabilities, answering the symbol.
//
// The shape LZMA uses for a literal's eight bits, for a length's low
// bits and for a distance's slot.  `probs` is the caller's array and
// `at` the index of the tree's first probability; the tree's
// probabilities are updated in place.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     let s = xzrange.decode_tree(xzrange.start(bytes.zeros(5), 0), 3,
//                                 bytes.zeros(64), 0, bytes.zeros(16), 0)
//     println("${s.bit}")
// ```
pub fn decode_tree(r: XzRange, n: Int, var probs: Bytes, at: Int, src: Bytes,
                   off: Int) -> XzRangeStep []
    tree_step(r, n, var probs, at, src, off, true)

// The same tree, read in reverse bit order.
//
// LZMA reads a distance's aligned low bits this way, and it is a
// separate function rather than a flag because a decoder that used the
// wrong one produces plausible, wrong output rather than an error.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     let s = xzrange.decode_tree_reverse(xzrange.start(bytes.zeros(5), 0), 4,
//                                         bytes.zeros(64), 0, bytes.zeros(16), 0)
//     println("${s.bit}")
// ```
pub fn decode_tree_reverse(r: XzRange, n: Int, var probs: Bytes, at: Int, src: Bytes,
                           off: Int) -> XzRangeStep []
    tree_step(r, n, var probs, at, src, off, false)

// A probability adapted towards a bit, without decoding anything.
//
// Published so a test can assert the adaptation rule on its own — it
// is three lines and two of them are shifts, and every port gets one
// of the two directions wrong at least once.
//
// ```novo
// use xzrange
//
// fn main() [io]
//     println("${xzrange.adapt(xzrange.XZ_PROB_INIT, 0)}")
// ```
pub fn adapt(prob: Int, bit: Int) -> Int []
    if bit == 0
        // Towards certainty of zero: up to but never reaching 2048.
        prob + ((XZ_PROB_INIT * 2 - prob) >> XZ_PROB_MOVE_BITS)
    else
        prob - (prob >> XZ_PROB_MOVE_BITS)

// Whether a finished coder is in the state a well-formed stream leaves
// it in: `code` exactly zero.
//
// LZMA2 does not rely on this, because its chunks carry their own
// sizes, but the legacy `.lzma` container with an unknown size does —
// and a decoder that skipped the check would read past the end of a
// truncated file.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     println("${xzrange.is_clean(xzrange.start(bytes.zeros(5), 0))}")
// ```
pub fn is_clean(r: XzRange) -> Bool []
    r.ok and r.code == 0

// How many bytes of the source a coder has consumed.
//
// ```novo
// use std.bytes
// use xzrange
//
// fn main() [io]
//     println("${xzrange.consumed_of(xzrange.start(bytes.zeros(5), 0))}")
// ```
pub fn consumed_of(r: XzRange) -> Int []
    r.consumed
