        len: 29000,
        crc32: "38ad2cbf" }]

@test
fn test_a_flipped_byte_in_a_real_file_is_refused() [io]
    // Every byte of the three smallest real streams — 32, 72 and 192
    // bytes, 296 flips — one at a time: the header CRC, the block header
    // CRC, the payload, the check and the index must each catch their
    // own bytes.
    let hexes = real_hexes()
    var accepted = 0
    for i in 0..list.len(hexes)
        let packed = bytes.from_hex(hexes[i]) ?? bytes.zeros(1)
        var at = 0
        while at < bytes.len(packed)
            var one = bytes.clone(packed)
            let old = bytes.byte_at(one, at) ?? 0
            bytes.set_u8(one, at, old ^ 0xFF)
            match xzdec.decompress(one)
                Ok(_)  =>
                    accepted = accepted + 1
                Err(_) => ()
            at = at + 1
    if accepted != 0
        test.fail("${accepted}" + " corrupted file(s) decoded anyway")
    test.assert(true)

// The three smallest real streams, and no others: the sweep above is
// quadratic in what is here.
fn real_hexes() -> [Str] []
    [
        "fd377a585a000004e6d6b446000000001cdf44211fb6f37d010000000004595a",
        "fd377a585a000004e6d6b4460200210116000000742fe5a301000e68656c6c6f20787a20776f726c640a00000bdab30dbe246b870001270fdf1afc6a1fb6f37d010000000004595a",
        ""]
