use std.bytes
use std.test
use xzdec
use xzcheck
use xzlzma

// The files the REAL `xz` wrote, and what this package's decoder makes of
// them.  Every stream here came out of `/usr/bin/xz`, not out of
// `xzenc.nv`: the encoder cannot make a file this suite could be wrong
// about in the same direction as its own decoder, so these are the only
// vectors in the package that a mistake in BOTH could not explain.
//
// WHAT IS PINNED AND WHY IT IS ENOUGH.  The content of the large ones
// cannot be written out here, so each is pinned by its length and by the
// CRC-32 of the bytes the real `xz` compressed — computed with `zlib`
// and not with anything in this repository.  A decoded block is also
// checked against the file's OWN integrity check (`xzdec.decompress`
// verifies every block), so a wrong answer here needs the range coder,
// the filter chain AND that check to be wrong together.

// One file's bytes and what decoding them must answer.
struct XzRealFile
    name: Str
    packed: Str
    len: Int
    crc32: Str

// The CRC-32 of a buffer as `xzcheck` writes it: little-endian.
fn crc32_of(b: Bytes) -> Str []
    let s = match xzcheck.start(xzcheck.XZ_CHECK_CRC32)
        Err(_) =>
            return ""
        Ok(x)  => x
    bytes.to_hex(xzcheck.finish(xzcheck.update(s, b, 0, bytes.len(b))))

// Decode one `.xz` and answer what is wrong with it, or "".
fn real_xz(f: XzRealFile) -> Str []
    let packed = bytes.from_hex(f.packed) ?? bytes.zeros(1)
    match xzdec.decompress(packed)
        Err(e) => f.name + ": " + e.message()
        Ok(b)  =>
            if bytes.len(b) != f.len
                f.name + ": " + "${bytes.len(b)}" + " bytes, want " + "${f.len}"
            else
                if crc32_of(b) == f.crc32
                    ""
                else
                    f.name + ": crc32 " + crc32_of(b) + " want " + f.crc32

// Decode one legacy `.lzma` the same way, with the bound rule 7 asks
// for: the format's own header may not say how large the content is.
fn real_lzma(f: XzRealFile) -> Str []
    let packed = bytes.from_hex(f.packed) ?? bytes.zeros(1)
    match xzlzma.decompress_alone(packed, 1048576)
        Err(e) => f.name + ": " + e.message()
        Ok(b)  =>
            if bytes.len(b) != f.len
                f.name + ": " + "${bytes.len(b)}" + " bytes, want " + "${f.len}"
            else
                if crc32_of(b) == f.crc32
                    ""
                else
                    f.name + ": crc32 " + crc32_of(b) + " want " + f.crc32

// The whole table, as four parallel lists: writing it as one list of
// structs would put a two-kilobyte line in the middle of the file.
fn names() -> [Str] []
    ["empty.p6.xz",
        "small.p6.xz",
        "small.block1.xz",
        "text.p6.xz",
        "text.p0.xz",
        "text.lc4pb0.xz",
        "text.dict64k.xz",
        "text.checknone.xz",
        "text.checkcrc32.xz",
        "text.checkcrc64.xz",
        "text.checksha256.xz",
        "text.blocks20k.xz",
        "text.blocks70k.xz",
        "pcm.delta2.xz",
        "pcm.delta3.xz",
        "pcm.delta2.p9.xz",
        "pcm.delta256.x86.xz",
        "zeros.p9.xz",
        "code.p6.xz"]

fn packs() -> [Str] []
    [
        "fd377a585a000004e6d6b446000000001cdf44211fb6f37d010000000004595a",
        "fd377a585a000004e6d6b4460200210116000000742fe5a301000e68656c6c6f20787a20776f726c640a00000bdab30dbe246b870001270fdf1afc6a1fb6f37d010000000004595a",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""]

fn lens() -> [Int] []
    [0,
        15,
        15,
        117000,
        117000,
        117000,
        117000,
        117000,
        117000,
        117000,
        117000,
        117000,
        117000,
        120000,
        120000,
        120000,
        120000,
        300000,
        44000]

fn crcs() -> [Str] []
    ["00000000",
        "c75dd6b2",
        "c75dd6b2",
        "ad21cf3d",
        "ad21cf3d",
        "ad21cf3d",
        "ad21cf3d",
        "ad21cf3d",
        "ad21cf3d",
        "ad21cf3d",
        "ad21cf3d",
        "ad21cf3d",
        "ad21cf3d",
        "e222d4f0",
        "e222d4f0",
        "e222d4f0",
        "e222d4f0",
        "fbe2b2f6",
        "9d7d520e"]

@test
fn test_the_files_the_real_xz_wrote_decode_to_the_bytes_they_were_made_from() [io]
    var report = ""
    let n = names()
    let p = packs()
    let l = lens()
    let c = crcs()
    for i in 0..list.len(n)
        let f = XzRealFile { name: n[i], packed: p[i], len: l[i], crc32: c[i] }
        let bad = real_xz(f)
        if bad != ""
            report = report + bad + "\n"
    if report != ""
        test.fail(report)
    test.assert(list.len(n) == 19)

@test
fn test_the_legacy_files_the_real_xz_wrote_read_back_too() [io]
    var report = ""
    let lz = lzma_files()
    for i in 0..list.len(lz)
        let bad = real_lzma(lz[i])
        if bad != ""
            report = report + bad + "\n"
    if report != ""
        test.fail(report)
    test.assert(list.len(lz) == 4)

fn lzma_files() -> [XzRealFile] []
    [
        XzRealFile { name: "lc0.lzma",
