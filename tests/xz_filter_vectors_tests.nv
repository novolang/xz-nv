@test
fn test_the_arm64_converter_matches_xz_byte_for_byte() [io]
    // BL and ADRP, including the ADRP window the filter refuses to
    // touch because its 21-bit page field would not survive.
    vector_branch(xzfilter.XZ_FILTER_ARM64,
        0,
        "96946bd260da12d0a914c3973170875f557c2e96a6f8d3b080c91f965b5f89af57af2fd0e6f2e3d00c585496198f5d9403871be7b21fa5e9578d0eb094007097253a3dd0f2a57786b3a024961e76c2b014d71a951bb03403b2ef2294412d5e4e",
        "96946bd260da12d0ab14c3973170875f597c2e96a6f8d3b086c91f965b5f89af57af2fd0e6f2e3d016585496248f5d9403871be7b21fa5e9578d0eb0a3007097253a3dd0f2a57786c5a024961e76c2b028d71a951bb03403c8ef2294412d5e4e")
    vector_branch(xzfilter.XZ_FILTER_ARM64,
        4,
        "96946bd260da12d0a914c3973170875f557c2e96a6f8d3b080c91f965b5f89af57af2fd0e6f2e3d00c585496198f5d9403871be7b21fa5e9578d0eb094007097253a3dd0f2a57786b3a024961e76c2b014d71a951bb03403b2ef2294412d5e4e",
        "96946bd260da12d0ac14c3973170875f5a7c2e96a6f8d3b087c91f965b5f89af57af2fd0e6f2e3d017585496258f5d9403871be7b21fa5e9578d0eb0a4007097253a3dd0f2a57786c6a024961e76c2b029d71a951bb03403c9ef2294412d5e4e")

@test
fn test_the_riscv_converter_round_trips_and_matches_its_reference() [io]
    // Nothing on this machine can filter RISC-V: xz 5.4.5 predates
    // the filter.  These two vectors come from the reference, so they
    // pin the port and the round trip, not agreement with xz.
    vector_branch(xzfilter.XZ_FILTER_RISCV,
        0,
        "974426ca50a4a3a6ef30bb1dcc75f636efd2d623ef22d91ea90d9df2f50ae695ef70174417cddb49ec636a8a8b15442ec5501830ef201e69",
        "974426ca50a4a3a6ef509cf1cc75f636ef326d26ef429500a90d9df2f50ae695ef30be3017cddb49ec636a8a8b15442ec5501830ef201e69")
    vector_branch(xzfilter.XZ_FILTER_RISCV,
        2,
        "974426ca50a4a3a6ef30bb1dcc75f636efd2d623ef22d91ea90d9df2f50ae695ef70174417cddb49ec636a8a8b15442ec5501830ef201e69",
        "974426ca50a4a3a6ef509cf2cc75f636ef326d27ef429501a90d9df2f50ae695ef30be3117cddb49ec636a8a8b15442ec5501830ef201e69")
