// xz_filter_vectors_tests.nv — byte-exact vectors for the delta filter
// and the eight branch converters.
//
// The expected bytes are not this package's own output run backwards:
// every vector except RISC-V was produced by the real `xz` 5.4.5,
//
//     xz --format=raw --check=none --<filter> --lzma2=dict=16MiB -c plain
//     xz --format=raw --lzma2=dict=16MiB -dc mid
//
// so the filter is checked against a foreign implementation in both
// directions: this package must reproduce xz's filtered bytes from the
// plain bytes, and must turn xz's filtered bytes back into the plain
// bytes.  `xz` 5.4.5 has no RISC-V filter, so those two vectors come
// from the reference implementation this module was written from, and
// prove only that the port matches the reference and round-trips.

use std.test
use std.bytes
use xzerror
use xzfilter

fn vector_hex(h: Str) -> Bytes
    match bytes.from_hex(h)
        Some(b) => b
        None    =>
            test.fail("the vector's own hex does not parse")
            bytes.zeros(0)

// A filter xz made, run over the plain bytes and back over the
// filtered ones — the two directions of one call each.
fn vector_filter(f: xzfilter.XzFilter, plain: Str, filtered: Str) [io]
    var buf = vector_hex(plain)
    let n = bytes.len(buf)
    match xzfilter.encode_in_place(f, buf, 0, n)
        Ok(b)  => test.assert_eq_str(bytes.to_hex(b), filtered)
        Err(e) => test.fail("encode refused a legal filter: "
                               + xzerror.kind_name(e.kind))
    var back = vector_hex(filtered)
    match xzfilter.decode_in_place(f, back, 0, n)
        Ok(b)  => test.assert_eq_str(bytes.to_hex(b), plain)
        Err(e) => test.fail("decode refused a legal filter: "
                               + xzerror.kind_name(e.kind))

fn vector_delta(dist: Int, plain: Str, filtered: Str) [io]
    match xzfilter.delta(dist)
        Ok(f)  => vector_filter(f, plain, filtered)
        Err(e) => test.fail("delta() refused a legal distance: "
                               + xzerror.kind_name(e.kind))

fn vector_branch(id: Int, start: Int, plain: Str, filtered: Str) [io]
    match xzfilter.branch(id, start)
        Ok(f)  => vector_filter(f, plain, filtered)
        Err(e) => test.fail("branch() refused a legal converter: "
                               + xzerror.kind_name(e.kind))

@test
fn test_the_delta_filter_matches_xz_byte_for_byte() [io]
    // One distance per vector; xz seeds its 256-byte ring with the
    // ORIGINAL bytes, so an in-place encode must read backwards.
    vector_delta(1,
        "000105060a0b0f090d0e1213171815161a1b1f20241e222327282c2d2a2b2f303435393337383c3d41423f404445494a4e484c4d515256575455595a5e5f635d616266676b6c696a6e6f7374787276777b7c80817e7f838488898d878b8c90919596939498999d9ea29ca0a1a5a6aaaba8a9adaeb2b3b7b1b5b6babbbfc0bdbe",
        "00010401040104fa040104010401fd010401040104fa040104010401fd010401040104fa040104010401fd010401040104fa040104010401fd010401040104fa040104010401fd010401040104fa040104010401fd010401040104fa040104010401fd010401040104fa040104010401fd010401040104fa040104010401fd01")
    vector_delta(3,
        "000105060a0b0f090d0e1213171815161a1b1f20241e222327282c2d2a2b2f303435393337383c3d41423f404445494a4e484c4d515256575455595a5e5f635d616266676b6c696a6e6f7374787276777b7c80817e7f838488898d878b8c9091",
        "00010506090609ff02ff0906090602ff0206090609ff02ff0906090602ff0206090609ff02ff0906090602ff0206090609ff02ff0906090602ff0206090609ff02ff0906090602ff0206090609ff02ff0906090602ff0206090609ff02ff0906")
    vector_delta(64,
        "000105060a0b0f090d0e1213171815161a1b1f20241e222327282c2d2a2b2f303435393337383c3d41423f404445494a4e484c4d515256575455595a5e5f635d616266676b6c696a6e6f7374787276777b7c80817e7f838488898d878b8c90919596939498999d9ea29ca0a1a5a6aaaba8a9adaeb2b3b7b1b5b6babbbfc0bdbe",
        "000105060a0b0f090d0e1213171815161a1b1f20241e222327282c2d2a2b2f303435393337383c3d41423f404445494a4e484c4d515256575455595a5e5f635d6161616161615a6161616161615a6161616161615a6161616161615a6161616161615a6161616161615a6161616161615a6161616161615a6161616161615a61")
    vector_delta(256,
        "ec03000012000000000000000000000000000000000000002a030000120000000000000000000000000000000000000051010000120000000000000000000000",
        "ec03000012000000000000000000000000000000000000002a030000120000000000000000000000000000000000000051010000120000000000000000000000")

@test
fn test_the_x86_converter_matches_xz_byte_for_byte() [io]
    // One vector is real x86-64 code out of /usr/bin/gcc, so the
    // E8/E9 statistics are not mine; the crafted one walks the
    // prev_mask chain that decides which destination byte is tested.
    vector_branch(xzfilter.XZ_FILTER_X86,
        0,
        "d00f820f90fcffe984a600000f1f4000415741564989ce41554d89c5415455534889fb4883ec78488b0532ac0b0048895424504889442410488b0519930b0048894424484084f60f85500200004531db31ed488b3df7ab0b004885ff741931d2be787e460031c04c891c24e81034ffff4c8b1c244889c7c60424004531e44889",
        "d00f820f90fcffe990a600000f1f4000415741564989ce41554d89c5415455534889fb4883ec78488b0532ac0b0048895424504889442410488b0519930b0048894424484084f60f85500200004531db31ed488b3df7ab0b004885ff741931d2be787e460031c04c891c24e88034ffff4c8b1c244889c7c60424004531e44889")
    vector_branch(xzfilter.XZ_FILTER_X86,
        0,
        "e8e84000110090e8e84100120090e8e84200130090e8e84300140090e8e84400150090e8e84500160090e8e84600170090e8e84700180090",
        "e8e84600110090e8e84e00120090e8e85600130090e8e85e00140090e8e86600150090e8e86e00160090e8e87600170090e8e87e00180090")
    vector_branch(xzfilter.XZ_FILTER_X86,
        0,
        "3dffdd2e00c0007e0be92e0000ff0600e9e9509114e8e89000e8ffb08e2db86ec2b7ffd9e0ff01e8e95516e85b1360124b00e9ffe8e847800053e9e8eddd00e8ff87e9e800e800c5ff3ce9a91c5ee85f8c76b2e8d8e9e87d25e9aa00e8ffe9ffffffe9e9f1e8ffcee90055e900e946f2e8ffff87ae44e9c2e9e8e9d49de86c4a",
        "3dffdd2e00c0007e0be93c0000ff0600e9e9509114e8e8ab00e8ffb08e2db86ec2b7ffd9e0ff01e8e95516e85b1360124b00e9ffe82148800053e927eedd00e8ff87e92f01e800c5ff3ce9a91c5ee85f8c76b2e8d8e9e87d25e90801e8ffe9ffffffe950f2e8ffcee96d55e900e9b8f2e8ffff87ae44e9c2e9e8e9d49de86c4a")
    vector_branch(xzfilter.XZ_FILTER_X86,
        0,
        "e8bb3d0300448b542410e9c3c40200488b8424880000004489b8a0000000e998c202004c89df4489442408e810bb0200be5cd24a004889c74989c7e810bfffff448b5424084889c74885ff745bbe52494b00448954241048897c2408e88fbcffff488b7c2408448b54241085c00f852f010000838d3c0d000002c645540131ff",
        "e8c03d0300448b542410e9d2c40200488b8424880000004489b8a0000000e9bbc202004c89df4489442408e840bb0200be5cd24a004889c74989c7e850bfffff448b5424084889c74885ff745bbe52494b00448954241048897c2408e8f0bcffff488b7c2408448b54241085c00f852f010000838d3c0d000002c645540131ff")
    vector_branch(xzfilter.XZ_FILTER_X86,
        16384,
        "d00f820f90fcffe984a600000f1f4000415741564989ce41554d89c5415455534889fb4883ec78488b0532ac0b0048895424504889442410488b0519930b0048894424484084f60f85500200004531db31ed488b3df7ab0b004885ff741931d2be787e460031c04c891c24e81034ffff4c8b1c244889c7c60424004531e44889",
        "d00f820f90fcffe990e600000f1f4000415741564989ce41554d89c5415455534889fb4883ec78488b0532ac0b0048895424504889442410488b0519930b0048894424484084f60f85500200004531db31ed488b3df7ab0b004885ff741931d2be787e460031c04c891c24e88074ffff4c8b1c244889c7c60424004531e44889")
    vector_branch(xzfilter.XZ_FILTER_X86,
        16384,
        "e8e84000110090e8e84100120090e8e84200130090e8e84300140090e8e84400150090e8e84500160090e8e84600170090e8e84700180090",
        "e8e84640110090e8e84e40120090e8e85640130090e8e85e40140090e8e86640150090e8e86e40160090e8e87640170090e8e87e40180090")
    vector_branch(xzfilter.XZ_FILTER_X86,
        16384,
        "3dffdd2e00c0007e0be92e0000ff0600e9e9509114e8e89000e8ffb08e2db86ec2b7ffd9e0ff01e8e95516e85b1360124b00e9ffe8e847800053e9e8eddd00e8ff87e9e800e800c5ff3ce9a91c5ee85f8c76b2e8d8e9e87d25e9aa00e8ffe9ffffffe9e9f1e8ffcee90055e900e946f2e8ffff87ae44e9c2e9e8e9d49de86c4a",
        "3dffdd2e00c0007e0be93c4000ff0600e9e9509114e8e8ab40e8ffb08e2db86ec2b7ffd9e0ff01e8e95516e85b1360124b00e9ffe82188800053e9272ede00e8ff87e92f41e800c5ff3ce9a91c5ee85f8c76b2e8d8e9e87d25e90841e8ffe9ffffffe95032e9ffcee96d95e900e9b832e9ffff87ae44e9c2e9e8e9d49de86c4a")
    vector_branch(xzfilter.XZ_FILTER_X86,
        16384,
        "e8bb3d0300448b542410e9c3c40200488b8424880000004489b8a0000000e998c202004c89df4489442408e810bb0200be5cd24a004889c74989c7e810bfffff448b5424084889c74885ff745bbe52494b00448954241048897c2408e88fbcffff488b7c2408448b54241085c00f852f010000838d3c0d000002c645540131ff",
        "e8c07d0300448b542410e9d2040300488b8424880000004489b8a0000000e9bb0203004c89df4489442408e840fb0200be5cd24a004889c74989c7e850ffffff448b5424084889c74885ff745bbe52494b00448954241048897c2408e8f0fcffff488b7c2408448b54241085c00f852f010000838d3c0d000002c645540131ff")

@test
fn test_the_powerpc_converter_matches_xz_byte_for_byte() [io]
    vector_branch(xzfilter.XZ_FILTER_POWERPC,
        0,
        "482e2b09499d80054851dc0d4ae3890148baee094bd8540549760c054a58450949e4d4094ab9e4054bec7f0d4affb50d4bb3e90d49a655094b9e9b0d4a6afa09",
        "482e2b09499d80094851dc154ae3890d48baee194bd8541949760c1d4a58452549e4d4294ab9e4294bec7f354affb5394bb3e93d49a6553d4b9e9b454a6afa45")
    vector_branch(xzfilter.XZ_FILTER_POWERPC,
        8,
        "482e2b09499d80054851dc0d4ae3890148baee094bd8540549760c054a58450949e4d4094ab9e4054bec7f0d4affb50d4bb3e90d49a655094b9e9b0d4a6afa09",
        "482e2b11499d80114851dc1d4ae3891548baee214bd8542149760c254a58452d49e4d4314ab9e4314bec7f3d4affb5414bb3e94549a655454b9e9b4d4a6afa4d")

@test
fn test_the_ia64_converter_matches_xz_byte_for_byte() [io]
    // Synthetic 16-byte bundles: template 22 has all three slots
    // flagged as branches, so each bundle holds three converted
    // instructions.
    vector_branch(xzfilter.XZ_FILTER_IA64,
        0,
        "160000400014000088002800002001501600048d0014000822012800105402501600081000140010280028002060005016000c28001400185800280030c000501600104400140020900028004030015016001480001400280801280050200250",
        "160000400014000088002800002001501600088d0014001022012800205402501600101000140020280028004060005016001828001400305800280060c0005016002044001400409000280080300150160028800014005008012800a0200250")
    vector_branch(xzfilter.XZ_FILTER_IA64,
        16,
        "160000400014000088002800002001501600048d0014000822012800105402501600081000140010280028002060005016000c28001400185800280030c000501600104400140020900028004030015016001480001400280801280050200250",
        "1600044000140008880028001020015016000c8d0014001822012800305402501600141000140028280028005060005016001c28001400385800280070c000501600244400140048900028009030015016002c800014005808012800b0200250")
    vector_branch(xzfilter.XZ_FILTER_IA64,
        0,
        "170040000014008002002800000900501700d048001400a093002800402b0150170010000014002002002800400800501000000000000000000000009099005000000000000000000000000000000000",
        "170040000014008002002800000900501700d448001400a893002800502b015017001800001400300200280060080050100000000000000000000000c099005000000000000000000000000000000000")
    vector_branch(xzfilter.XZ_FILTER_IA64,
        16,
        "170040000014008002002800000900501700d048001400a093002800402b0150170010000014002002002800400800501000000000000000000000009099005000000000000000000000000000000000",
        "170044000014008802002800100900501700d848001400b093002800602b015017001c00001400380200280070080050100000000000000000000000d099005000000000000000000000000000000000")

@test
fn test_the_arm_converter_matches_xz_byte_for_byte() [io]
    vector_branch(xzfilter.XZ_FILTER_ARM,
        0,
        "7942bdebf22106ebf08477eb62f0f3ebcb4d76eb4dc707eb205115eb9a0f89ebf2c6daebcae344ebbb3112eb45fd6feb84df9aebd7c5b3ebd076aceb0e8f53eb",
        "7b42bdebf52106ebf48477eb67f0f3ebd14d76eb54c707eb285115eba30f89ebfcc6daebd5e344ebc73112eb52fd6feb92df9aebe6c5b3ebe076aceb1f8f53eb")
    vector_branch(xzfilter.XZ_FILTER_ARM,
        4,
        "7942bdebf22106ebf08477eb62f0f3ebcb4d76eb4dc707eb205115eb9a0f89ebf2c6daebcae344ebbb3112eb45fd6feb84df9aebd7c5b3ebd076aceb0e8f53eb",
        "7c42bdebf62106ebf58477eb68f0f3ebd24d76eb55c707eb295115eba40f89ebfdc6daebd6e344ebc83112eb53fd6feb93df9aebe7c5b3ebe176aceb208f53eb")

